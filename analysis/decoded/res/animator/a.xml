<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="150" android:valueTo="0.98" android:propertyName="scaleX" />
            <objectAnimator android:duration="150" android:valueTo="0.98" android:propertyName="scaleY" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:valueTo="1" android:propertyName="scaleX" />
            <objectAnimator android:valueTo="1" android:propertyName="scaleY" />
        </set>
    </item>
</selector>