<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:interpolator="@android:anim/accelerate_interpolator" android:duration="250" android:valueFrom="1" android:valueTo="0.96" android:valueType="floatType" android:propertyName="scaleX" />
            <objectAnimator android:interpolator="@android:anim/accelerate_interpolator" android:duration="250" android:valueFrom="1" android:valueTo="0.96" android:propertyName="scaleY" />
            <objectAnimator android:interpolator="@android:anim/accelerate_interpolator" android:duration="250" android:valueFrom="1" android:valueTo="0.8" android:propertyName="alpha" />
        </set>
    </item>
    <item android:state_pressed="false">
        <set>
            <objectAnimator android:interpolator="@android:anim/accelerate_interpolator" android:duration="250" android:valueFrom="0.96" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleX" />
            <objectAnimator android:interpolator="@android:anim/accelerate_interpolator" android:duration="250" android:valueFrom="0.96" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleY" />
            <objectAnimator android:interpolator="@android:anim/accelerate_interpolator" android:duration="250" android:valueFrom="0.8" android:valueTo="1" android:propertyName="alpha" />
        </set>
    </item>
</selector>