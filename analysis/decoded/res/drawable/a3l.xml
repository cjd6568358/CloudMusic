<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:id="@id/visible" android:drawable="@drawable/a3k" />
    <item android:id="@id/masked" android:drawable="@drawable/a3j" />
    <transition android:drawable="@drawable/ir" android:toId="@id/visible" android:fromId="@id/masked" />
    <transition android:drawable="@drawable/is" android:toId="@id/masked" android:fromId="@id/visible" />
</animated-selector>