<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="18.0dip" android:bottomRightRadius="18.0dip" />
            <gradient android:startColor="#ffff3131" android:endColor="#ff52a4ff" android:angle="45.0" android:centerColor="#ffe05fff" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topRightRadius="18.0dip" android:bottomRightRadius="18.0dip" />
                    <gradient android:startColor="#ffff3131" android:endColor="#ff52a4ff" android:angle="45.0" android:centerColor="#ffe05fff" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topRightRadius="18.0dip" android:bottomRightRadius="18.0dip" />
                    <solid android:color="#19000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>