<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="17.0dip" />
            <gradient android:startColor="#fffe345a" android:endColor="#ffd14ca5" android:angle="0.0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="17.0dip" />
                    <gradient android:startColor="#fffe345a" android:endColor="#ffd14ca5" android:angle="0.0" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="17.0dip" />
                    <solid android:color="@color/dv" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>