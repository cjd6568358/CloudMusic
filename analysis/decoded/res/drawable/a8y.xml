<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <stroke android:width="1.0px" android:color="@color/vc" />
            <solid android:color="@color/ve" />
            <corners android:bottomLeftRadius="5.0dip" android:bottomRightRadius="5.0dip" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <stroke android:width="1.0px" android:color="@color/vd" />
            <solid android:color="@color/vf" />
            <corners android:bottomLeftRadius="5.0dip" android:bottomRightRadius="5.0dip" />
        </shape>
    </item>
</selector>