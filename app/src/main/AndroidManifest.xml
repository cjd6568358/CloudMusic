<?xml version="1.0" encoding="utf-8"?>
<!-- docs/03-11 §1 / §1.1：V0.1 最终权限清单，共 11 项（≤12）。
     C3 (tools/check-permissions.py) 校验数量 / 白名单 / allowBackup=false。
     多人协作：本文件不含任何本机路径。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- neverForLocation：本项目不申请任何位置权限（03-11 §1.1）。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 10 §2 R4 已拍板：DataStore 明文凭据禁止随系统备份上云，不可回退。
         Hilt 应用入口：启动时一次性注册 DataSourceModule 提供的 Driver factory。 -->
    <!-- T-A5（12 §31 / 03-11 §1.1）：组件声明落 :app（:feature-player 是纯 JVM、无 Manifest）。
         新增 service / receiver 不新增任何权限，11 项 ≤12 与 C3 检查不变。 -->
    <!-- 12 §57：PRD 01 §6.1 支持 HTTP 音源（strm / WebDAV / 本地回环代理）。
         targetSdk >= 28 默认禁止明文流量，App 内 HttpURLConnection 对 http://
         会抛 UnknownServiceException，HEAD 探测与 Range 取流全部失败。
         这里只放开明文流量策略，不新增任何权限（11 项 / C3 白名单不变）。 -->
    <application
        android:name=".CloudMusicApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- T-A6（12 §33 / 03-10 §5）：Compose 自研页面入口；播放页照搬属 T-L L3。 -->
        <!-- ★ 12 §61.33 口径定论：LAUNCHER 必须保持 exported=true，A3 验收后**不改回 false**。
             Android 官方 <activity> 文档：含 intent-filter 且需被其它应用（Launcher）启动时
             必须 exported=true；设为 false 时外部应用启动会抛 ActivityNotFoundException
             （https://developer.android.com/guide/topics/manifest/activity-element）。
             §61.23 / §61.24 记的「随 Service 一并恢复」只适用于 PlaybackService。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- §61.24（A3 验收期调试改动）：exported=true + ACTION_PLAY intent-filter
             是判据 D/E 真机实验的触发路径（am start-foreground-service 直启 performPlay），
             无线 adb shell 无法启动非导出组件。
             ★ 12 §61.33 生产形态施工单（A3 收口后执行）：本组件改回 exported=false
             并移除下面这段 <intent-filter>；生产播放由 UI / 通知 / 媒体键在进程内触发。
             注意只改 Service —— MainActivity 的 LAUNCHER 必须保持 exported=true。 -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="com.example.cloudmusic.action.PLAY" />
                <!-- §61.111：ACTION_SEEK（§61.26）/ ACTION_EFFECT（§61.93）同为
                     验收期调试入口，此前不在 filter 内 → am startservice 隐式启动
                     一直被拒（Unable to start service，真机一手 F3 enhanced 取证）；
                     补全使其可达。F5 收口时随 PLAY 一并移除。 -->
                <action android:name="com.example.cloudmusic.action.SEEK" />
                <action android:name="com.example.cloudmusic.action.EFFECT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- 03-07 §5 B12：兼容兜底；主入口为 MediaSession.Callback，Receiver 不重复处理按键。
             §61.23：exported=true（系统媒体键广播需要；MEDIA_BUTTON intent-filter 必须可接收）。 -->
        <receiver
            android:name=".MediaButtonEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
