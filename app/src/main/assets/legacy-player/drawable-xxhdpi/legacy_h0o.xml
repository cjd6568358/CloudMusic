<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background" android:height="8.0dip">
        <shape>
            <solid android:color="@color/b1h" />
            <corners android:radius="50.0dip" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress" android:height="8.0dip">
        <clip>
            <shape>
                <solid android:color="@color/b1h" />
                <corners android:radius="50.0dip" />
            </shape>
        </clip>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress" android:height="8.0dip">
        <scale android:scaleWidth="100%">
            <shape>
                <solid android:color="@color/b1t" />
                <corners android:radius="50.0dip" />
            </shape>
        </scale>
    </item>
</layer-list>